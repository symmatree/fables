# Targeted Betaflight CLI snippet
# Softer tune + throttle SCALE 80% for Flywoo Firefly 16.
# Assumes factory layout: PID profile 1, rateprofile 0
#
# Values: master / D / FF at baseline 100; PI down 10 from factory 145 to 135;
# D-term filter multiplier 91 (factory 85, modestly less filtering than 100);
# throttle SCALE 80% on rateprofile 0.
#
# simplified_tuning apply: recomputes raw P/I/D/F and related values from the
# simplified sliders. Without it, Configurator may hide Basic sliders and say
# values are outside the basic mode range (slider model vs stored coeffs mismatch).
#
# Paste into Configurator CLI, watch for errors, then fly a careful hover test.

batch start

profile 1
set simplified_master_multiplier = 100
set simplified_d_gain = 100
set simplified_feedforward_gain = 100
set simplified_pi_gain = 135
set simplified_dterm_filter_multiplier = 91

batch end

profile 1
simplified_tuning apply

batch start

rateprofile 0
set throttle_limit_type = SCALE
set throttle_limit_percent = 80

batch end

save
